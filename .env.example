# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
# Replace this development-only Fernet key outside local development.
FIELD_ENCRYPTION_KEYS=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# PostgreSQL
POSTGRES_DB=pulsea
POSTGRES_USER=pulsea
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_EXPOSE_PORT=5433

# Redis and Celery
REDIS_URL=redis://redis:6379/0
REDIS_EXPOSE_PORT=6380
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
PUBLISHING_ADAPTER_MODE=fake

# Private media storage: local or s3
PRIVATE_STORAGE_BACKEND=local
PRIVATE_MEDIA_ROOT=/app/media-private
MEDIA_MAX_IMAGE_UPLOAD_BYTES=20971520
MEDIA_MAX_VIDEO_UPLOAD_BYTES=524288000
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email
DEFAULT_FROM_EMAIL=Pulsea <noreply@example.com>
PUBLIC_CONTACT_EMAIL=Pulsea <privacy@example.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Application URLs
APP_BASE_URL=http://localhost:8000
WEB_EXPOSE_PORT=8000

# Meta OAuth
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_GRAPH_API_VERSION=v23.0
META_OAUTH_REDIRECT_URI=http://localhost:8000/operator/connections/meta/callback/

# Instagram Login for professional accounts
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v23.0
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:8000/operator/connections/instagram/callback/
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=pulsea-instagram-webhook-2026
INSTAGRAM_CONTAINER_POLL_ATTEMPTS=5
INSTAGRAM_CONTAINER_POLL_INTERVAL_SECONDS=60

# Pinterest OAuth
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_OAUTH_REDIRECT_URI=http://localhost:8000/operator/connections/pinterest/callback/
